{
  "name": "moment-booth-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "yarn workspace moment-booth-fe dev",
    "start": "yarn workspace moment-booth-fe start",
    "build": "yarn workspace moment-booth-fe build",
    "lint": "yarn workspace moment-booth-fe lint",
    "test": "yarn workspace moment-booth-fe test",
    "test:startup": "node --test tests/startup.test.mjs",
    "test:vercel": "node --test tests/vercel-build.test.mjs"
  },
  "devDependencies": {
    "elij-ui-library-cli": "^0.1.1"
  }
}
