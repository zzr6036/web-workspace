{
  "name": "moment-booth-fe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "yarn workspace elij-ui-library build && yarn dev:local",
    "dev:local": "vite --config vite.local.config.ts",
    "build": "yarn workspace elij-ui-library build && NITRO_PRESET=vercel vinext build",
    "start": "yarn dev",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern .vinext --ignore-pattern .wrangler",
    "test": "node --test tests/*.test.mjs",
    "dev:cloudflare": "vinext dev",
    "start:production": "vinext start"
  },
  "dependencies": {
    "elij-ui-library": "workspace:*",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "nitro": "^3.0.260903-beta",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "webpack": "^5.0.0",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
